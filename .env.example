# VITE_BACKEND_URL: origin of the Express/webretro backend, used by the browser
# to build direct links to the emulator app and stored ROMs (e.g. the player iframe).
VITE_BACKEND_URL="http://localhost:8000"

# BACKEND_URL: same backend origin, used server-side by server.js (production)
# to proxy /api/* requests from the built frontend to the real backend.
BACKEND_URL="http://localhost:8000"
